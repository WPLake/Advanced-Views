#: src/Plugin/Dashboard/html/dashboard/import.php:107
msgid "Creates a Layout called \"Phone\" that displays fields from the \"Phone\" Field Group."
msgstr "Crea un Diseño llamado \"Teléfono\" que muestra campos del Grupo de Campos \"Teléfono\"."

#: src/Plugin/Dashboard/html/dashboard/import.php:117
msgid "Populates each page’s ACF fields with sample text and adds the Layout shortcode to the page content."
msgstr "Puebla los campos ACF de cada página con texto de muestra y añade el shortcode del Diseño al contenido de la página."

#: src/Plugin/Dashboard/html/dashboard/import.php:133
msgid "Creates a \"draft\" page called \"Article about Samsung\""
msgstr "Crea una página \"borrador\" llamada \"Artículo sobre Samsung\""

#: src/Plugin/Dashboard/html/dashboard/import.php:139
msgid "Adds a Layout shortcode to the page content with \"object-id\" parameter pointing to \"Samsung Galaxy A53\"."
msgstr "Añade un shortcode de Diseño al contenido de la página con el parámetro \"object-id\" apuntando a \"Samsung Galaxy A53\"."

#: src/Plugin/Dashboard/html/dashboard/import.php:150
